#!/usr/bin/env python3
# Codex context % and reasoning effort for the Herdr session header (mods/issue-session).
# Hook mode (stdin JSON from SessionStart / UserPromptSubmit / Stop) binds the terminal
# via HC_TERMINAL_ID. Pane mode (--pane ID --cwd PATH) is what the header polls, so a
# Codex tab shows the latest rollout even before the next hook.
# Writes the same files ccsl-wrap and herdr-cursor-status write. Prints nothing:
# UserPromptSubmit would otherwise inject stdout into the conversation.

import json
import os
import sys
import time
from pathlib import Path

HOME = Path.home()
SESSIONS = HOME / ".claude/herdr-sidebar/sessions"
INDEX = HOME / ".claude/herdr-sidebar/codex-index.json"
ROLLOUTS = HOME / ".codex/sessions"
MODELS = HOME / ".codex/models_cache.json"
KEEP = 7 * 24 * 3600
SAFE = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")


def safe_id(value):
    text = str(value or "")
    return text if text and all(c in SAFE for c in text) else ""


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name("." + path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def load_index():
    try:
        return json.loads(INDEX.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_index(index):
    atomic(INDEX, json.dumps(index))


def first_object(path):
    with path.open("rb") as fh:
        line = fh.readline(2_000_000)
    try:
        return json.loads(line)
    except json.JSONDecodeError:
        return {}


def meta_of(path):
    payload = first_object(path).get("payload") or {}
    return {
        "cwd": payload.get("cwd") or "",
        "originator": payload.get("originator") or "",
        "source": payload.get("source") or "",
        "session_id": payload.get("session_id") or "",
    }


def interactive(meta):
    return meta.get("source") != "exec" and meta.get("originator") != "codex_exec"


def recent_rollouts():
    now = time.time()
    found = []
    if not ROLLOUTS.is_dir():
        return found
    for path in ROLLOUTS.rglob("rollout-*.jsonl"):
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if now - mtime <= KEEP:
            found.append((mtime, path))
    found.sort(key=lambda item: item[0], reverse=True)
    return found


def rollout_for_session(session_id):
    for _mtime, path in recent_rollouts():
        if session_id in path.name:
            return path
    return None


def rollout_for_cwd(cwd, bound=None):
    if bound and bound.is_file():
        return bound
    wanted = os.path.realpath(cwd) if cwd else ""
    if not wanted:
        return None
    index = load_index()
    ranked = []
    seen = set()
    for mtime, path in recent_rollouts():
        key = str(path)
        seen.add(key)
        cached = index.get(key)
        if not cached or cached.get("mtime") != mtime:
            cached = meta_of(path)
            cached["mtime"] = mtime
            index[key] = cached
        if not interactive(cached):
            continue
        session_cwd = cached.get("cwd") or ""
        if not session_cwd:
            continue
        there = os.path.realpath(session_cwd)
        if there == wanted:
            rank = 0
        elif there != os.path.realpath(HOME) and wanted.startswith(there.rstrip("/") + "/"):
            rank = 1
        else:
            continue
        ranked.append((rank, -mtime, path))
    stale = [key for key in index if key not in seen]
    for key in stale:
        del index[key]
    save_index(index)
    if not ranked:
        return None
    ranked.sort()
    return ranked[0][2]


def tail_state(path):
    size = path.stat().st_size
    with path.open("rb") as fh:
        fh.seek(max(0, size - 2_000_000))
        blob = fh.read().decode("utf-8", "replace")
    lines = blob.splitlines()
    if size > 2_000_000 and lines:
        lines = lines[1:]
    model = effort = window = used = None
    for line in lines:
        if "token_count" not in line and "turn_context" not in line and "reasoning_effort" not in line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = obj.get("payload") or {}
        if obj.get("type") == "turn_context":
            model = payload.get("model") or model
            effort = payload.get("effort") or effort
        elif obj.get("type") == "event_msg" and payload.get("type") == "token_count":
            info = payload.get("info") or {}
            window = info.get("model_context_window") or window
            last = info.get("last_token_usage") or {}
            if isinstance(last.get("input_tokens"), (int, float)):
                used = last["input_tokens"]
        elif obj.get("type") == "event_msg" and payload.get("type") == "thread_settings_applied":
            settings = payload.get("thread_settings") or {}
            model = settings.get("model") or model
            effort = settings.get("reasoning_effort") or effort
    return model, effort, window, used


def display_name(slug, index):
    if not slug:
        return "Codex"
    names = index.setdefault("_display", {})
    if slug in names:
        return names[slug]
    found = slug
    if MODELS.is_file():
        needle = f'"slug": "{slug}"'
        prev = ""
        with MODELS.open("r", errors="replace") as fh:
            while True:
                chunk = fh.read(1 << 20)
                if not chunk:
                    break
                buf = prev + chunk
                at = buf.find(needle)
                if at >= 0:
                    window = buf[at:at + 300]
                    mark = '"display_name": "'
                    start = window.find(mark)
                    if start >= 0:
                        start += len(mark)
                        end = window.find('"', start)
                        if end > start:
                            found = window[start:end]
                    break
                prev = buf[-200:]
    names[slug] = found
    return found


def percentage(used, window):
    if not isinstance(used, (int, float)) or not isinstance(window, (int, float)) or window <= 0:
        return None
    return max(0, min(100, round(used / window * 1000) / 10))


def publish(session_id, rollout, terminal, model_hint):
    session_id = safe_id(session_id)
    if not session_id or rollout is None or not rollout.is_file():
        return
    model, effort, window, used = tail_state(rollout)
    model = model or model_hint or ""
    pct = percentage(used, window)
    now = int(time.time())
    index = load_index()
    status = {
        "session_id": session_id,
        "model": {"id": model, "display_name": display_name(model, index)},
        "effort": {"level": effort} if effort else None,
        "context_window": {
            "used_percentage": pct,
            "context_window_size": window,
            "total_input_tokens": used,
        },
    }
    body = {"session_id": session_id, "at": now, "terminal": terminal or "", "status": status}
    save_index(index)
    atomic(SESSIONS / f"{session_id}.status.json", json.dumps(body, separators=(",", ":")))
    if terminal and safe_id(terminal) == terminal:
        atomic(SESSIONS / f"term-{terminal}.json", json.dumps({"session_id": session_id, "at": now}))


def from_hook(payload):
    session_id = safe_id(payload.get("session_id"))
    if not session_id:
        return
    transcript = payload.get("transcript_path") or ""
    rollout = Path(transcript) if transcript and Path(transcript).is_file() else rollout_for_session(session_id)
    publish(session_id, rollout, os.environ.get("HC_TERMINAL_ID") or "", payload.get("model") or "")


def from_pane(terminal, cwd):
    term_path = SESSIONS / f"term-{terminal}.json"
    bound = None
    try:
        current = json.loads(term_path.read_text())
        sid = safe_id(current.get("session_id"))
        if sid:
            bound = rollout_for_session(sid)
    except (OSError, json.JSONDecodeError):
        bound = None
    if bound and cwd:
        there = os.path.realpath((meta_of(bound).get("cwd") or ""))
        wanted = os.path.realpath(cwd)
        if there and wanted != there and not wanted.startswith(there.rstrip("/") + "/"):
            bound = None
    rollout = bound or rollout_for_cwd(cwd)
    if rollout is None:
        return
    session_id = safe_id(meta_of(rollout).get("session_id"))
    # Filename ends with the full uuid, which contains hyphens, so take the id from meta.
    publish(session_id, rollout, terminal, "")


def main():
    args = sys.argv[1:]
    if "--pane" in args:
        terminal = args[args.index("--pane") + 1]
        cwd = args[args.index("--cwd") + 1] if "--cwd" in args else ""
        if safe_id(terminal):
            from_pane(terminal, cwd)
        return
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    if raw.strip():
        try:
            from_hook(json.loads(raw))
        except json.JSONDecodeError:
            pass


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
